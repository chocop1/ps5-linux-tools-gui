<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>PS5 Linux Tools</vendor>
  <vendor_url>https://github.com/</vendor_url>
  <action id="org.ps5linuxtools.helper">
    <description>Manage PS5 hardware, fan curves, services, and M.2 SSD</description>
    <description xml:lang="ru">Управление оборудованием PS5, вентилятором, службами и M.2 SSD</description>
    <message>Authentication is required to manage PS5 Linux hardware and services</message>
    <message xml:lang="ru">Требуется авторизация для управления оборудованием и службами PS5 Linux</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/ps5tools-helper</annotate>
  </action>
</policyconfig>
